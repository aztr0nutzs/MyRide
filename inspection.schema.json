{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f150-garage-assistant.local/schema/inspection.schema.json",
  "title": "Inspection",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "entityType",
    "knowledgeScope",
    "title",
    "description",
    "systemId",
    "applicability",
    "checkpointIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entityType": {
      "const": "inspection"
    },
    "knowledgeScope": {
      "enum": [
        "generic",
        "vehicle_specific",
        "configuration_specific"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ]
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "systemId": {
      "type": "string"
    },
    "applicability": {
      "type": "object",
      "properties": {
        "vehicleIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "configurationIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "checkpointIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "safetyRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "completionCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mediaIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
