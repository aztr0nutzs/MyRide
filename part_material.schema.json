{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f150-garage-assistant.local/schema/part_material.schema.json",
  "title": "Part Material",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "entityType",
    "knowledgeScope",
    "name",
    "type",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entityType": {
      "const": "part_material"
    },
    "knowledgeScope": {
      "enum": [
        "generic",
        "vehicle_specific",
        "configuration_specific"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ]
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "part",
        "fluid",
        "consumable",
        "material",
        "hardware",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "requiredByProcedureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "source"
        ],
        "properties": {
          "value": {},
          "unit": {
            "type": "string"
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "referenceIds",
              "verificationStatus"
            ],
            "properties": {
              "referenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "verificationStatus": {
                "enum": [
                  "verified",
                  "partially_verified",
                  "unverified",
                  "unknown"
                ]
              },
              "verifiedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "verificationNotes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
