{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f150-garage-assistant.local/schema/inspection_result.schema.json",
  "title": "Inspection Result",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "entityType",
    "knowledgeScope",
    "vehicleId",
    "inspectionId",
    "checkpointId",
    "result",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entityType": {
      "const": "inspection_result"
    },
    "knowledgeScope": {
      "enum": [
        "generic",
        "vehicle_specific",
        "configuration_specific"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "vehicleId": {
      "type": "string"
    },
    "inspectionId": {
      "type": "string"
    },
    "checkpointId": {
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "warning",
        "fail",
        "unknown",
        "not_applicable"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation": {
      "type": [
        "string",
        "null"
      ]
    },
    "measurement": {
      "type": [
        "object",
        "null"
      ]
    },
    "noteIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "photoIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "safetyRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
