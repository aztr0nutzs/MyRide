{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f150-garage-assistant.local/schema/repair_record.schema.json",
  "title": "Repair Record",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "entityType",
    "knowledgeScope",
    "vehicleId",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entityType": {
      "const": "repair_record"
    },
    "knowledgeScope": {
      "enum": [
        "generic",
        "vehicle_specific",
        "configuration_specific"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ]
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "vehicleId": {
      "type": "string"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "mileage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "systemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "componentIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string"
    },
    "procedureId": {
      "type": [
        "string",
        "null"
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findingIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "noteIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "photoIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
