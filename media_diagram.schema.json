{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f150-garage-assistant.local/schema/media_diagram.schema.json",
  "title": "Media Diagram",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "entityType",
    "knowledgeScope",
    "title",
    "mediaType",
    "path",
    "altText"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entityType": {
      "const": "media_diagram"
    },
    "knowledgeScope": {
      "enum": [
        "generic",
        "vehicle_specific",
        "configuration_specific"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ]
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "mediaType": {
      "enum": [
        "svg",
        "png",
        "jpg",
        "webp",
        "video",
        "other"
      ]
    },
    "path": {
      "type": "string"
    },
    "altText": {
      "type": "string"
    },
    "caption": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceReferenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "accessibilityLabel": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
